# Copy these into Vercel → Settings → Environment Variables.
# Never commit an actual .env file with real values.

# ---------- Gemini ----------
GOOGLE_API_KEY=
CHAT_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=models/gemini-embedding-001

# ---------- LangSmith (optional tracing) ----------
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=casa-alon

# ---------- Google Doc knowledge base ----------
# The Doc must be shared as "Anyone with the link: Viewer".
GDOC_ID=
REFRESH_SECONDS=60

# ---------- Upstash Redis ----------
# Create via Vercel Storage tab -> Marketplace -> Upstash, which fills
# these in for you automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Staff alerts ----------
# Email address that receives alerts: guests asking for a person, holds placed,
# and failed reservations. Defaults to SMTP_USER (the sending account).
STAFF_ALERT_EMAIL=

# ---------- Staff handoff webhook (optional) ----------
# e.g. an n8n Webhook node URL. Receives an alert when the bot hands off
# to staff, or when it creates a reservation.
STAFF_WEBHOOK_URL=

# ---------- Hotelogix PMS ----------
# mock (default): sample data, no API needed. hotelogix: the real thing.
PMS_PROVIDER=mock
HOTELOGIX_BASE_URL=http://crs.hotelogix.net/ws/web
HOTELOGIX_CONSUMER_KEY=
HOTELOGIX_CONSUMER_SECRET=
HOTELOGIX_HOTEL_ID=
HOTELOGIX_DEBUG=false
HOTELOGIX_PRICE_IS_TOTAL=true
HOTELOGIX_RATE_TYPES=
HOTELOGIX_GUEST_COUNTRY_CODE=PH
HOTELOGIX_GUEST_COUNTRY=Philippines

# Booking classification — must match your property's Hotelogix setup
# exactly. List valid values with pms.HotelogixClient.get_hotel_options().
HOTELOGIX_BUSINESS_SOURCE=
HOTELOGIX_SOURCE_BY_CHANNEL=
HOTELOGIX_MARKET_SEGMENT=
HOTELOGIX_GUEST_TYPE=
HOTELOGIX_SALESPERSON=

# ---------- Reservations ----------
# false (default): the bot only places reservations ON HOLD; staff confirm
# them in Hotelogix. true: the bot also confirms them (payment type "Other",
# no payment collected).
BOOKINGS_ENABLED=false
HOTELOGIX_CONFIRM_BOOKINGS=false
MAX_BOOKINGS_PER_GUEST_PER_DAY=2
MAX_NIGHTS=30

# ---------- Website widget ----------
# Comma-separated list of origins allowed to use /api/chat from a browser.
# Leave empty while the widget is same-origin (the normal case here).
WEB_ALLOWED_ORIGINS=
WEB_RATE_PER_MINUTE=8
WEB_RATE_PER_IP_PER_MINUTE=30
WEB_RATE_PER_IP_PER_DAY=300

# ---------- Email confirmation ----------
# The guest confirms reservations by email. Works with a Gmail account:
# turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Casa Alon Hotel
# Your site's address, used for the Confirm link. If empty, Vercel's
# production domain is used automatically.
PUBLIC_BASE_URL=
CONFIRM_LINK_HOURS=24
MAX_CONFIRM_EMAILS_PER_GUEST_PER_DAY=3
# Placing holds: after saving (Temp Reserved), the bot blocks the booking until its
# hold date with a pay-later payment type. Staff mark it Reserved once paid.
HOTELOGIX_HOLD_VIA_CONFIRM=true
# Hotelogix code for the pay-later payment type used to block the booking.
HOTELOGIX_HOLD_PAYMENT_TYPE=bank
# Seconds to wait for Hotelogix: lookups, and booking saves (which can be slow).
HOTELOGIX_TIMEOUT=20
HOTELOGIX_SAVE_TIMEOUT=40
# Hold expiry format sent to Hotelogix (Python strftime codes).
HOTELOGIX_HOLD_TILL_FORMAT=%Y-%m-%d %H:%M:%S
# false (default): Hotelogix doesn't email the guest; the bot's emails are used instead.
HOTELOGIX_SEND_EMAIL=false
